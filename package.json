{
  "name": "scmusic",
  "version": "3.3.1",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "apk:install": "adb -d install -r dist/SCMusic-$(node -p \"require('./app.json').expo.version\").apk",
    "apk:sign": "bash scripts/sign-apk.sh",
    "apk:publish": "bash scripts/publish-release.sh"
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "SCMusic : lecteur de musique local, libre et open source",
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
